{
  "name": "elara-angelic-utility-applet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "vite",
    "predev": "npm run fonts:prepare",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "prebuild": "npm run fonts:prepare",
    "fonts:prepare": "node scripts/prepare-fonts.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "reliability:check": "node scripts/reliability-gate.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "dexie": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "^8.1.0",
    "vitest": "4.1.11"
  }
}
