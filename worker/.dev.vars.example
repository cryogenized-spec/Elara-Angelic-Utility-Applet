# Copy this file to worker/.dev.vars for local Wrangler development.
# Never commit worker/.dev.vars.
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_TOKEN_ENCRYPTION_KEY=
APP_ORIGIN=http://127.0.0.1:5173
GOOGLE_OAUTH_REDIRECT_URI=https://127.0.0.1:8787/api/google/oauth/callback
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Google OAuth sessions/tokens require a KV binding named GOOGLE_OAUTH_KV.
# Use a local Wrangler KV simulation for development and the dedicated production
# namespace declared in worker/wrangler.toml for deployment.
